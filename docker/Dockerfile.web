# syntax=docker/dockerfile:1
# Stage 1: Build frontend (Vite/React)
# Tip: For 1-line changes, run "npm run dev" in coaching-platform-frontend/ (HMR = instant). Use this image build only for production/CI.
FROM node:18-alpine AS frontend-build
WORKDIR /app

COPY coaching-platform-frontend/package*.json ./
# Reuse npm cache when package.json changes (BuildKit; default in Docker 23+)
RUN --mount=type=cache,target=/root/.npm \
    npm install
COPY coaching-platform-frontend/ ./

ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=/api

RUN npm run build

# Stage 2: Nginx - serve frontend and proxy API
FROM nginx:alpine

COPY --from=frontend-build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
