# ============================================
# English Learning App - Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ============================================
# API Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:5000/api
# Production: http://localhost:5000/api

# ============================================
# Razorpay Configuration (Public Key)
# ============================================
# Note: Only the public key (key_id) is safe to expose in frontend
VITE_RAZORPAY_KEY_ID=your_razorpay_public_key_id

# ============================================
# Bunny Stream Configuration (Optional)
# ============================================
# These are used for video player configuration
VITE_BUNNY_STREAM_LIBRARY_ID=your-library-id
VITE_BUNNY_STREAM_API_KEY=your-bunny-stream-api-key

# ============================================
# Notes
# ============================================
# 1. Vite requires VITE_ prefix for environment variables
# 2. Access variables using: import.meta.env.VITE_VARIABLE_NAME
# 3. Never expose secret keys in frontend
# 4. Razorpay key_secret should NEVER be in frontend
