# coaching-platform-backend/.gitignore

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json # If you are using yarn.lock primarily, or vice-versa
# yarn.lock       # If you are using package-lock.json primarily

# Environment variables
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db

# Storage system files
temp_uploads/
public/processed_files/
public/

# Temporary files

# Build output (if any, e.g., from TypeScript compilation if not done in Docker)
dist/
build/

# Docker - if you build images locally and don't want to track them,
# but usually not needed here as Dockerfile defines the build.

# Logs
logs/
*.log

# Development documentation and guide files
# Ignore all markdown files except README.md
*.md
!README.md

# Ignore guide files (any extension with guide in name, case-insensitive)
*[Gg]uide*
*[Ii]nstructions*
*[Rr]eference*
*[Ss]ummary*
*[Ss]olution*
*[Qq]uick*

# Ignore specific development documentation patterns
**/ANDROID_*
**/COMPLETE_*
**/GOOGLE_*
**/MULTI_*
**/OAUTH_*
**/PRODUCTION_*
**/TOPIC_*
**/SOLUTION_*
# Allow .env.example to be committed
!.env.example
