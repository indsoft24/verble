# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ============================================
# Database Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017/verble
MONGODB_URI_DOCKER=mongodb://mongo:27017/verble

# ============================================
# Redis Configuration (Optional - for session management)
# ============================================
REDIS_URL=redis://localhost:6379
# Alternative: redis://redis:6379 (for Docker)

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_SECONDS=604800

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ============================================
# Mobile OTP Configuration
# ============================================
# Currently uses Email delivery (SMS ready for DLT verification)
DEFAULT_COUNTRY_CODE=+91

# SMS Provider Configuration (For Future Use)
SMS_PROVIDER=mock
# Options: mock, twilio, aws-sns, messagebird, msg91

# Twilio Configuration (When SMS is ready)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (When SMS is ready)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# MessageBird Configuration (When SMS is ready)
MESSAGEBIRD_API_KEY=your_messagebird_api_key
MESSAGEBIRD_ORIGINATOR=Verble

# MSG91 Configuration (When SMS is ready - Popular in India)
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=VERBLE
MSG91_OTP_TEMPLATE_ID=your_template_id

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Application
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_WEB_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Android Application
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_REDIRECT_URI=com.yourcompany.app:/oauth2redirect

# iOS Application
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ============================================
# Frontend URLs (Multi-app support)
# ============================================
FRONTEND_URL=http://localhost:3000
# Removed app-specific frontend URL=https://knowledgenation.online
# Frontend URL configuration
# FRONTEND_URL=https://www.verble.app

# ============================================
# Razorpay Payment Gateway Configuration
# ============================================
# First IAS App
# Removed app-specific Razorpay config=your_razorpay_key_id
# Removed app-specific Razorpay config=your_razorpay_key_secret
# Removed app-specific Razorpay config=your_webhook_secret

# Knowledge Nation App
# Removed app-specific Razorpay config=your_razorpay_key_id
# Removed app-specific Razorpay config=your_razorpay_key_secret
# Removed app-specific Razorpay config=your_webhook_secret

# Legacy/Default (for backward compatibility)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# Bunny Storage Configuration
# ============================================
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_ZONE_NAME=your-storage-zone-name
BUNNY_STORAGE_ACCESS_KEY=your-bunny-storage-access-key

# ============================================
# Bunny Stream Configuration
# ============================================
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-bunny-stream-api-key
BUNNY_TOKEN_AUTH_KEY=your-token-auth-key
VIDEO_TOKEN_EXPIRATION_SECONDS=1200
ALLOWED_VIDEO_DOMAINS=localhost:3000,yourdomain.com

# ============================================
# AI/ML Configuration
# ============================================
# OpenAI Configuration (for AI validation)
OPENAI_API_KEY=sk-your-openai-api-key
ENABLE_AI_VALIDATION=false
ENABLE_AUTO_VALIDATION=false

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# Scheduled Tasks Configuration
# ============================================
# Daily Notifications
ENABLE_DAILY_NOTIFICATIONS=true
DAILY_NOTIFICATION_SCHEDULE=0 9 * * *
# Format: minute hour day month dayOfWeek
# '0 9 * * *' = Every day at 9:00 AM

# Subscription Expiration Check
ENABLE_SUBSCRIPTION_EXPIRATION_CHECK=true
SUBSCRIPTION_EXPIRATION_SCHEDULE=0 2 * * *
# Format: minute hour day month dayOfWeek
# '0 2 * * *' = Every day at 2:00 AM

# Timezone for scheduled tasks
TZ=Asia/Kolkata

# ============================================
# Security Configuration
# ============================================
# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

Field	Value
Email	admin@verble.app
Password	Admin@123