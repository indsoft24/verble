# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ============================================
# Database Configuration
# ============================================
MONGODB_URI=mongodb://localhost:27017/verble
MONGODB_URI_DOCKER=mongodb://mongo:27017/verble

# ============================================
# Redis Configuration (Optional - for session management)
# ============================================
REDIS_URL=redis://localhost:6379
# Alternative: redis://redis:6379 (for Docker)

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=f81103d080d72e2d6c03847be526bb141cee3fedda82f5a29faf0a3c28e62496
JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN_SECONDS=604800

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=varbleofficial@gmail.com
EMAIL_PASS=oczkztwphyhkkxri

# ============================================
# Mobile OTP Configuration
# ============================================
# Currently uses Email delivery (SMS ready for DLT verification)
DEFAULT_COUNTRY_CODE=+91

# SMS Provider Configuration (For Future Use)
SMS_PROVIDER=mock
# Options: mock, twilio, aws-sns, messagebird, msg91

# Twilio Configuration (When SMS is ready)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (When SMS is ready)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# MessageBird Configuration (When SMS is ready)
MESSAGEBIRD_API_KEY=your_messagebird_api_key
MESSAGEBIRD_ORIGINATOR=Verble

# MSG91 Configuration (When SMS is ready - Popular in India)
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=VERBLE
MSG91_OTP_TEMPLATE_ID=your_template_id

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Web Application
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_WEB_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Android Application
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_REDIRECT_URI=com.yourcompany.app:/oauth2redirect

# iOS Application
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ============================================
# Frontend URLs (Multi-app support)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# Razorpay Payment Gateway Configuration
# ============================================

# Legacy/Default (for backward compatibility)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# Public API URL (images, materials — stored on this server under uploads/)
# ============================================
# Set to the site origin that serves /api (no trailing slash). e.g. https://verble.in
API_PUBLIC_ORIGIN=https://verble.in

# ============================================
# Video security (local HLS playback)
# ============================================
VIDEO_TOKEN_EXPIRATION_SECONDS=1200
ALLOWED_VIDEO_DOMAINS=localhost:3000,yourdomain.com

# ============================================
# Self-hosted video (FFmpeg HLS on disk)
# ============================================
# Absolute path on the server/container. In Docker, bind-mount a host directory to uploads and set:
# VIDEO_STORAGE_ROOT=/usr/src/app/uploads/videos
VIDEO_STORAGE_ROOT=
# Max upload size in bytes (default 4 GiB)
VIDEO_UPLOAD_MAX_BYTES=4294967296
# Keep original file after transcode (default: deleted to save space)
KEEP_UPLOADED_SOURCE_VIDEO=false

# ============================================
# AI/ML Configuration
# ============================================
# OpenAI Configuration (for AI validation)
OPENAI_API_KEY=AIzaSyAZDvG2uuxLFYV34zchgnjxr3KSWCmx-8U
ENABLE_AI_VALIDATION=false
ENABLE_AUTO_VALIDATION=false

# Gemini AI Configuration
GEMINI_API_KEY=AIzaSyAZDvG2uuxLFYV34zchgnjxr3KSWCmx-8U

# ============================================
# Scheduled Tasks Configuration
# ============================================
# Daily Notifications
ENABLE_DAILY_NOTIFICATIONS=true
DAILY_NOTIFICATION_SCHEDULE=0 9 * * *
# Format: minute hour day month dayOfWeek
# '0 9 * * *' = Every day at 9:00 AM

# Subscription Expiration Check
ENABLE_SUBSCRIPTION_EXPIRATION_CHECK=true
SUBSCRIPTION_EXPIRATION_SCHEDULE=0 2 * * *
# Format: minute hour day month dayOfWeek
# '0 2 * * *' = Every day at 2:00 AM

# Timezone for scheduled tasks
TZ=Asia/Kolkata

# ============================================
# Security Configuration
# ============================================
# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://verble.in

# ============================================
# Database Manager (Admin)
# ============================================
# Optional allow-list (comma-separated). If empty, any admin can access.
DB_MANAGER_ALLOWED_EMAILS=
# Optional restricted collections (comma-separated)
DB_MANAGER_RESTRICTED_COLLECTIONS=users

